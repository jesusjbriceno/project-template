# ── Docker Compose environment variables ──────────────────
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored — never commit secrets.

# PostgreSQL
POSTGRES_DB=projecttemplate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_password

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# Migration service
MIGRATION_CONNECTIONSTRING=Host=db;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# Seed — superadmin credentials (used when migration seeding is implemented)
SUPERADMIN_EMAIL=admin@project-template.local
SUPERADMIN_PASSWORD=replace_with_secure_password

# JWT Authentication — bound to configuration section "Jwt" via options pattern.
# .NET convention: double-underscore env vars map to nested config keys.
#   Jwt__Secret        →  configuration["Jwt:Secret"]
#   Jwt__Issuer        →  configuration["Jwt:Issuer"]
#   Jwt__Audience      →  configuration["Jwt:Audience"]
#   Jwt__RefreshTokenDays → configuration["Jwt:RefreshTokenDays"]
#
# Generate a secure random secret (≥32 characters):
#   openssl rand -base64 32
Jwt__Secret=CHANGE_ME
Jwt__Issuer=project-template-api
Jwt__Audience=project-template-client
Jwt__RefreshTokenDays=7

# Frontend
VITE_API_BASE_URL=http://localhost:8080
